# URL base del backend, SIN el sufijo /api. Ejemplos:
#   VITE_API_URL=http://localhost:3000
#   VITE_API_URL=https://api.abrigar.org
#
# Si se deja vacío o se omite, el frontend usa la ruta relativa /api:
#   - en desarrollo la resuelve el proxy de Vite hacia http://localhost:3000
#   - en producción funciona cuando el front y el back comparten dominio
VITE_API_URL=
